# Compilados de Rust: se rehacen con `cargo build --release`.
target/

# El entorno de Python del oido y sus modelos descargados.
.venv/
*.onnx
*.onnx.data
*.bin
*.gguf

# Salida de cada ejecucion. Los .json de resultados SI se guardan: son la
# evidencia de cada comparacion, y pesan nada.
*.log
*.out
*.jpg
!escenas/**/*.jpg

# Cache de Data Dragon: se rehace sola por parche.
ddragon/

# Certificados de la partida falsa: se regeneran solos.
*.pem

# Notas de cada partida (aumentos elegidos): son del usuario, no del codigo.
partidas/

# Capturas de la pantalla de eleccion de aumentos: son de las partidas del usuario.
prueba-lol/eleccion-*.png
prueba-lol/eleccion-*.bmp

# Audio generado por el banco de voces: se rehace con voz/banco_voz.py.
voz/salida/

# La DLL de OjoTexto (ddragon.ps1): se compila sola la primera vez.
bin/

# Busquedas web cacheadas (una por consulta y dia): son de lo que pregunta el
# usuario.
web-cache/

# El humor aprendido cada dia (humor.ps1): se rehace solo.
humor/

__pycache__/

# La ultima frase dicha de cada momento (para no repetirla): estado de uso.
frases/.ultima-*
frases/.pullas-recientes

# Datos personales del usuario: su perfil, su memoria de personas y la
# conversacion reciente. Se generan y se aprenden solos.
perfil.json
personas/
historial.json
conocer/estado.json
